# Sirf wo keys bharo jo tumhare paas hain. Baaki khali chhor do.
# Is file ko '.env' naam se save karo (.env GitHub par nahi jati).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Kis tarteeb mein providers try hon (jin ki key ho wahi chalte hain)
PROVIDER_ORDER=groq,openai,claude,gemini

# Shortlist mein kitne candidates
TOP_N=3

# Do AI calls ke beech kam az kam itne second (rate limit se bachne ke liye)
MIN_SECONDS_BETWEEN_CALLS=1.0

# Folders / files (default theek hain)
# CV_DIR=input/cvs
# JD_FILE=input/job_description.txt
# OUTPUT_DIR=output
# LOG_FILE=logs/portal.log
